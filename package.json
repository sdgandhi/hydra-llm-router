{
  "name": "hydra-llm-router",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "bin": {
    "hydra": "./src/cli.js"
  },
  "scripts": {
    "dev:setup": "node scripts/dev-setup.js",
    "dev:login": "scripts/dev-codex login",
    "dev:serve": "node scripts/dev-hydra.js serve",
    "dev:stop": "node scripts/dev-hydra.js stop",
    "dev:codex": "scripts/dev-codex",
    "dev:route": "node scripts/dev-hydra.js route",
    "dev:prompt": "node scripts/dev-hydra.js prompt",
    "dev:session": "node scripts/dev-hydra.js session",
    "benchmark": "node benchmark/run.js",
    "dmg:dev": "node scripts/build-macos.js --dev",
    "dmg:release": "node scripts/build-macos.js --release",
    "test": "node --test",
    "test:check": "npm test && node --check src/router.js && node --check src/cli.js && node --check src/debug.js && node --check scripts/dev-context.js && node --check scripts/dev-setup.js && node --check scripts/dev-hydra.js && sh -n scripts/dev-codex",
    "start": "node src/cli.js serve"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "@openai/codex": "0.150.1"
  }
}
